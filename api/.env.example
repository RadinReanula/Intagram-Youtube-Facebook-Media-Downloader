# Copy to api/.env on the server. All limits are read at startup.

HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=https://your-app.vercel.app
ADMIN_TOKEN=replace-with-a-long-random-string
DOWNLOAD_SIGNING_SECRET=replace-with-a-different-long-random-string
TURNSTILE_SECRET=

MAX_CONCURRENT_JOBS=1
MAX_QUEUE_LENGTH=20
MAX_DURATION_SECONDS=1800
MAX_FILE_SIZE_BYTES=524288000
JOB_TIMEOUT_SECONDS=600
FILE_TTL_SECONDS=900
METADATA_CACHE_TTL_SECONDS=300
RATE_LIMIT=20/minute
MEMORY_THRESHOLD_PERCENT=85
DISK_THRESHOLD_PERCENT=90
DISK_LIMIT_BYTES=2147483648
MP3_QUALITY=5

TEMP_DIR=/var/lib/media-downloader/tmp
DATABASE_PATH=/var/lib/media-downloader/jobs.sqlite

ENABLE_INSTAGRAM=true
ENABLE_FACEBOOK=true
ENABLE_YOUTUBE=true
ENABLE_INSTAGRAM_LOGIN=false
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
MAX_SESSIONS=200
COOKIE_SECURE=true

YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
LOG_LEVEL=INFO
